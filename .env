# --- Prototype environment (safe defaults, not for production) ---

# SQLite database file (swap datasource to Postgres later)
DATABASE_URL="file:./dev.db"

# Auth.js (NextAuth v5). Regenerate for any real deployment: `openssl rand -base64 32`
AUTH_SECRET="dev-only-secret-change-me-000000000000000000="
AUTH_TRUST_HOST="true"
